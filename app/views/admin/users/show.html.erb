<div class="container">
  <div class="dashboard-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h1 class="mb-0"><i class="bi bi-person-lines-fill"></i> <%= @user.email %></h1>
      <p class="text-secondary mb-0">Joined <%= @user.created_at.strftime("%b %-d, %Y %-l:%M %p") %></p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Back to all users", admin_users_path, class: "btn btn-outline-primary btn-sm" %>
      <% unless @user.admin? %>
        <%= button_to "Delete user", admin_user_path(@user), method: :delete,
              class: "btn btn-danger btn-sm",
              data: {
                confirm: "Delete #{@user.email} and all their monitored URLs and people? This cannot be undone.",
                turbo_confirm: "Delete #{@user.email} and all their monitored URLs and people? This cannot be undone."
              } %>
      <% end %>
    </div>
  </div>

  <h2 class="h5">People (<%= @people.size %>)</h2>
  <% if @people.any? %>
    <div class="table-responsive bg-white rounded shadow-sm mb-4">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Color</th>
          </tr>
        </thead>
        <tbody>
          <% @people.each do |person| %>
            <tr>
              <td><%= person.name %></td>
              <td>
                <span class="badge" style="background-color: <%= person.color %>;">&nbsp;</span>
                <%= person.color %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-secondary mb-4">No people added.</p>
  <% end %>

  <h2 class="h5">Monitored URLs (<%= @monitored_urls.size %>)</h2>
  <% if @monitored_urls.any? %>
    <div class="table-responsive bg-white rounded shadow-sm">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>URL</th>
            <th>Sport</th>
            <th>Tournament Date</th>
            <th>Active</th>
            <th>Schedule Available</th>
            <th>Last Checked</th>
            <th>Snapshots</th>
          </tr>
        </thead>
        <tbody>
          <% @monitored_urls.each do |monitored_url| %>
            <tr>
              <td><%= monitored_url.name %></td>
              <td><%= link_to monitored_url.url, monitored_url.url, target: "_blank", rel: "noopener noreferrer", class: "url-link" %></td>
              <td><%= monitored_url.sport %></td>
              <td><%= monitored_url.tournament_start_date %></td>
              <td><%= monitored_url.active? ? "Yes" : "No" %></td>
              <td><%= monitored_url.schedule_available? ? "Yes" : "No" %></td>
              <td><%= monitored_url.last_checked_at&.strftime("%b %-d, %Y %-l:%M %p") || "Never" %></td>
              <td><%= monitored_url.schedule_snapshots.size %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-secondary">No monitored URLs.</p>
  <% end %>
</div>
