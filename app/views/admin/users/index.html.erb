<div class="container">
  <div class="dashboard-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="mb-0"><i class="bi bi-shield-lock"></i> Admin: Users</h1>
    <span class="badge badge-primary"><%= pluralize(@users.size, "user") %></span>
  </div>

  <div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Email</th>
          <th>Joined</th>
          <th>Monitored URLs</th>
          <th>People</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td>
              <%= user.email %>
              <% if user.admin? %>
                <span class="badge badge-success ms-1">Admin</span>
              <% end %>
            </td>
            <td><%= user.created_at.strftime("%b %-d, %Y %-l:%M %p") %></td>
            <td><%= user.monitored_urls.size %></td>
            <td><%= user.people.size %></td>
            <td class="text-end">
              <%= link_to "View", admin_user_path(user), class: "btn btn-outline-primary btn-sm" %>
              <% unless user.admin? %>
                <%= button_to "Delete", admin_user_path(user), method: :delete,
                      class: "btn btn-danger btn-sm",
                      data: {
                        confirm: "Delete #{user.email} and all their monitored URLs and people? This cannot be undone.",
                        turbo_confirm: "Delete #{user.email} and all their monitored URLs and people? This cannot be undone."
                      } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
