{
  "name": "app",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.js",
    "build:watch": "node esbuild.watch.js",
    "build:css": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --style=compressed --quiet-deps --load-path=node_modules",
    "watch:css": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --watch --no-source-map --quiet-deps --load-path=node_modules",
    "test": "node --test test/javascript/*.test.mjs"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.97.3",
    "@vue/compiler-sfc": "^3.5.27"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
