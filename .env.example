DATABASE_URL=postgresql://localhost/schedule_development
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini
# Optional: set a browser path if automatic Chrome/Chromium discovery fails.
# CHROME_PATH=/usr/bin/google-chrome
BROWSER_CONCURRENCY=1
DB_POOL=10
MAX_URLS_PER_USER=50

# SendGrid example. Resend is also supported by omitting SMTP_ADDRESS and setting
# RESEND_API_KEY. Alternate notification recipients do not need verification.
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_DOMAIN=tourneyping.com
SMTP_USERNAME=apikey
SMTP_PASSWORD=replace_me
FROM_EMAIL=noreply@tourneyping.com
APP_HOST=tourneyping.com
# ADMIN_EMAIL receives signup notices; it NEVER grants admin privileges.
# ADMIN_EMAIL=owner@example.com
